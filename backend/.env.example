# MongoDB Atlas
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@cluster.mongodb.net/decocars?retryWrites=true&w=majority

# Seguridad: genere una cadena aleatoria de 32+ caracteres
JWT_SECRET=CAMBIE_ESTO_POR_UNA_CLAVE_ALEATORIA_MUY_LARGA_DE_32_CARACTERES_O_MAS
JWT_EXPIRES_IN=8h

# Servidor
PORT=5000
NODE_ENV=development

# Si frontend y backend están en el mismo servidor, puede dejarlo vacío.
# Si están separados, coloque el dominio exacto del frontend.
FRONTEND_ORIGIN=

# Para frontend/backend en dominios distintos use:
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# Administrador inicial
ADMIN_EMAIL=admin@decocars.cr
ADMIN_PASSWORD=CAMBIE_ESTA_CONTRASENA
ADMIN_NAME=Administrador
